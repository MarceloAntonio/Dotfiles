{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": ["custom/arch", "hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "custom/notification", "group/power"],

    "custom/arch": {
        "format" : "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "WhiteSur-dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Notificações",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/reboot",
            "custom/lock",
            "custom/logout"
        ]
    },

    "custom/power": {
        "format": " 󰤆 ",
        "tooltip": true,
        "tooltip-format": "Desligar",
        "on-click": "shutdown now"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip": true,
        "tooltip-format": "Reiniciar",
        "on-click": "reboot"
    },

    "custom/lock": {
        "format": "󰍁",
        "tooltip": true,
        "tooltip-format": "Bloquear",
        "on-click": "swaylock"
    },

    "custom/logout": {
        "format": "󰗼",
        "tooltip": true,
        "tooltip-format": "Sair",
        "on-click": "hyprctl dispatch exit"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "cursor": true,
        "format": "{name}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = {name} })'" 
    },



    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤮 ",
        "tooltip-format": "{ipaddr} via {gwaddr}",
        "on-click": "pulsar toggle --tab wifi",
        "on-click-right": "nmcli radio wifi toggle"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "on-click": "pulsar toggle --tab bluetooth",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{time}",
        "cursor": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [" "]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%d/%m/%Y : %H:%M} ",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}

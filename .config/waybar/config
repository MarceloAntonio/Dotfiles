{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/status",
        "custom/notification",
        "group/power"
    ],
    "group/status": {
        "orientation": "inherit",
        "modules": [
            "network",
            "bluetooth",
            "group/audio",
            "battery"
        ]
    },
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 300,
            "children-class": "audio-slider"
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "custom/arch": {
        "exec": "~/.config/waybar/scripts/distro-icon.sh",
        "format": "{}",
        "interval": "once",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/binds.sh",
        "on-click-right": "rofi -show drun"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "WhiteSur-dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },
    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Notificações",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/reboot",
            "custom/lock",
            "custom/logout"
        ]
    },
    "custom/power": {
        "format": "󰤆",
        "tooltip": true,
        "tooltip-format": "Desligar",
        "on-click": "~/.config/waybar/scripts/confirm.sh Desligar systemctl poweroff"
    },
    "custom/reboot": {
        "format": "󰜉",
        "tooltip": true,
        "tooltip-format": "Reiniciar",
        "on-click": "~/.config/waybar/scripts/confirm.sh Reiniciar systemctl reboot"
    },
    "custom/lock": {
        "format": "󰍁",
        "tooltip": true,
        "tooltip-format": "Bloquear",
        "on-click": "hyprlock"
    },
    "custom/logout": {
        "format": "󰗼",
        "tooltip": true,
        "tooltip-format": "Sair",
        "on-click": "~/.config/waybar/scripts/confirm.sh Sair hyprctl dispatch 'hl.dsp.exit()'"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "cursor": true,
        "format": "{name}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = {name} })'"
    },
    "network": {
        "tooltip-format": "{ipaddr} via {gwaddr}",
        "on-click": "pulsar toggle --tab wifi",
        "on-click-right": "nmcli radio wifi toggle",
        "format-wifi": "",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤮"
    },
    "bluetooth": {
        "format": "<span size='large'>󰂯</span>",
        "format-disabled": "<span size='large'>󰂲</span>",
        "format-connected": "<span size='large'>󰂱</span>",
        "on-click": "pulsar toggle --tab bluetooth",
        "on-click-right": "rfkill toggle bluetooth"
    },
    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{time}",
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": " {volume}%",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                ""
            ]
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d/%m/%Y  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "today": "<u>{}</u>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}

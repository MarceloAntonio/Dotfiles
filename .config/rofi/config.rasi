configuration {
    scroll-method: 1;
    scrollbar: false;
    show-icons: true;
    display-run: "  Run";
    display-drun: "  Apps";
    display-emoji: "  Emoji";
    drun-display-format: "{icon} {name}";
    modi: "run,drun";
}

* {
    font: "Inter SemiBold 11";

    glass-bg:           rgba( 19,  19,  19, 0.55 );
    glass-bg-element:   rgba(255, 255, 255, 0.04 );
    glass-bg-hover:     rgba(255, 255, 255, 0.10 );
    glass-bg-selected:  rgba(255, 255, 255, 0.12 );
    glass-border:       rgba(255, 255, 255, 0.10 );
    glass-border-hover: rgba(255, 255, 255, 0.18 );
    text-primary:       #FFFFFF;
    text-muted:         rgba(255, 255, 255, 0.55);
}

#window {
    border:           1px solid;
    border-color:     @glass-border;
    border-radius:    18px;
    transparency:     "real";
    background-color: @glass-bg;
    padding:          16px;
    width:            620px;
}

#mainbox {
    background-color: transparent;
    spacing:          12px;
}

#inputbar {
    children:         [ textbox-search, entry ];
    spacing:          0;
    padding:          12px 16px;
    border:           1px solid;
    border-color:     @glass-border;
    border-radius:    12px;
    background-color: @glass-bg-element;
}

textbox-search {
    str:              "󰍉";
    font:             "JetBrainsMono Nerd Font 14";
    expand:           false;
    margin:           0 10px 0 0;
    vertical-align:   0.5;
    text-color:       @text-muted;
    background-color: transparent;
}

#prompt {
    spacing:          0;
    text-color:       @text-muted;
    background-color: transparent;
}

#textbox-prompt-colon {
    expand:           false;
    str:              ">";
    margin:           0px 0.3em 0em 0em;
    text-color:       @text-muted;
    background-color: transparent;
}

#entry {
    placeholder:       "Pesquisar...";
    placeholder-color: @text-muted;
    spacing:           0;
    text-color:        @text-primary;

}

#listview {
    lines:            7;
    fixed-height:     0;
    border:           0px;
    spacing:          4px;
    padding:          4px 0px 0px;
    background-color: transparent;
}

#element {
    border:           1px solid;
    border-color:     transparent;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          12px;
    background-color: @glass-bg-element;
    transition:       200;
}

#element.normal.normal {
    background-color: @glass-bg-element;
    text-color:       @text-primary;
}

#element.alternate.normal {
    background-color: @glass-bg-element;
    text-color:       @text-primary;
}

#element.selected.normal {
    background-color: @glass-bg-selected;
    border-color:     @glass-border-hover;
    text-color:       @text-primary;
}

#element.normal.active {
    background-color: @glass-bg-hover;
    text-color:       @text-primary;
}

#element.selected.active {
    background-color: @glass-bg-selected;
    border-color:     @glass-border-hover;
    text-color:       @text-primary;
}

element-icon {
    size:             28px;
    vertical-align:   0.5;

}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}

#scrollbar {
    width:            0px;
    border:           0;
    handle-width:     0px;
    padding:          0;
    handle-color:     @glass-border;
}

#message {
    background-color: transparent;
    border:           0;
}

#textbox {
    text-color:       @text-muted;
    background-color: transparent;
}

[Unit]
Description=Quickshell session lock integration with logind
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python %h/.config/quickshell/session-lock/bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

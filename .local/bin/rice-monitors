#!/usr/bin/env python3
"""Open the Quickshell monitor configurator, starting the shell if needed."""
import subprocess
import sys
import time
subprocess.run(['qs','-c','control-center','--no-duplicate','--daemonize'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
base=['qs','-c','control-center','ipc','call','monitors']
for _ in range(25):
    result=subprocess.run(base+['status'],capture_output=True,text=True)
    if result.returncode == 0 and '"opened"' in result.stdout:
        raise SystemExit(subprocess.run(base+['open']).returncode)
    time.sleep(.1)
print('O configurador de monitores não ficou disponível.',file=sys.stderr)
raise SystemExit(1)

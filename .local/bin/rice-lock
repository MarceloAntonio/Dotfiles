#!/usr/bin/env python3
"""Start the isolated locker; --suspend waits for compositor confirmation."""
import fcntl, json, os, pathlib, subprocess, sys, time
home = pathlib.Path.home()
try: _LANG = open('/etc/locale.conf').read().splitlines()
except OSError: _LANG = []
EN = any(line.strip().startswith('LANG=en') for line in _LANG)
def tr(pt, en): return en if EN else pt
runtime = pathlib.Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))

def secure():
    try:
        result = subprocess.run(['qs','-c','session-lock','ipc','call','lock','status'], capture_output=True, text=True, timeout=.8)
        return json.loads(result.stdout).get('secure') is True
    except (ValueError, subprocess.TimeoutExpired): return False

if '--status' in sys.argv:
    print(json.dumps({'secure': secure()})); raise SystemExit(0)
if '--preview' in sys.argv:
    os.execvp('qs',['qs','-p',str(home/'.config/quickshell/session-lock/preview.qml'),'--no-duplicate'])
if '--suspend' in sys.argv or '--ensure-secure' in sys.argv:
    if not secure():
        subprocess.Popen([str(home/'.local/bin/rice-lock')], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + (4 if "--ensure-secure" in sys.argv else 8)
    while time.monotonic() < deadline:
        if secure():
            if '--suspend' in sys.argv: subprocess.run(['systemctl','suspend'],check=True)
            raise SystemExit(0)
        time.sleep(.1)
    print(tr('Não foi possível confirmar o bloqueio. Suspensão cancelada.', 'Could not confirm the lock. Suspend canceled.'),file=sys.stderr)
    raise SystemExit(1)

with (runtime/'rice-lock.launch').open('w') as guard:
    try: fcntl.flock(guard,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError: raise SystemExit(0)
    if secure(): raise SystemExit(0)
    logdir=home/'.local/state/quickshell-lock';logdir.mkdir(parents=True,exist_ok=True)
    with (logdir/'last.log').open('w') as log:
        process=subprocess.Popen(['qs','-c','session-lock','--no-duplicate'],stdout=log,stderr=subprocess.STDOUT)
        result=process.wait()
    if result != 0:
        # Never terminate a potentially acquired Wayland lock. A compositor
        # keeps the session locked if the lock client dies.
        print(tr('O bloqueador Quickshell terminou com erro; tentando Hyprlock.', 'The Quickshell locker failed; trying Hyprlock.'),file=sys.stderr)
        raise SystemExit(subprocess.call(['hyprlock']))
